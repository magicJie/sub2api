# 复制为 local.env（已被 .gitignore 忽略）后填写。testenv.sh smoke / e2e 会读取。
# Key 是在测试环境管理后台里手动创建的 sub2api API Key，不是上游供应商密钥。
# 留空的平台会被跳过。

SMOKE_ANTHROPIC_KEY=
SMOKE_ANTHROPIC_MODEL=claude-sonnet-4-5

SMOKE_OPENAI_KEY=
SMOKE_OPENAI_MODEL=gpt-5

# e2e 的 Gemini 用例（可选）
SMOKE_GEMINI_KEY=

# 单个请求超时（秒）
SMOKE_TIMEOUT=120

# RT 冲突检查：up / restore 启动 sub2api 前比对测试库和生产库的 refresh token 哈希，
# 发现共用就拒绝启动（共用 RT 时一边刷新另一边就失效）。留空则跳过检查。
TESTENV_PROD_KUBECONFIG=
# TESTENV_PROD_NAMESPACE=sub2api
# TESTENV_PROD_PG_DEPLOY=deploy/postgres

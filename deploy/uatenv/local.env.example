# 复制为 local.env（已被 .gitignore 忽略）后填写。uatenv.sh 会读取。
# 冒烟 Key 是导入生产数据后在 uatenv 管理后台里创建的 sub2api API Key，不是上游供应商密钥。
# 留空的平台会被跳过。

SMOKE_ANTHROPIC_KEY=
SMOKE_ANTHROPIC_MODEL=claude-sonnet-4-5

SMOKE_OPENAI_KEY=
SMOKE_OPENAI_MODEL=gpt-5

# 单个请求超时（秒）
SMOKE_TIMEOUT=120

# 生产 kubeconfig：生产复刻、只读比对和 RT 冲突检查都需要。只放路径，不放内容。
UATENV_PROD_KUBECONFIG=
# UATENV_PROD_CONTEXT=default
# UATENV_PROD_NAMESPACE=sub2api
# UATENV_PROD_PG_DEPLOY=deploy/postgres

# 运行态目录（默认值如下），含生产数据，目录 0700、文件 0600。
# UATENV_SNAPSHOT_DIR=/data/sre/bsj/sub2api/uatenv/snapshots
# UATENV_PROD_WORK_DIR=/data/sre/bsj/sub2api/uatenv/prod-import

# 生产桥接所在的外部 Docker 网络（默认由 testenv 创建）。
# UATENV_BRIDGE_NETWORK=sub2api-testenv_testenv
